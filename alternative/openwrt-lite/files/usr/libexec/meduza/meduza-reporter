#!/bin/sh
set -u

. /lib/functions.sh
. /usr/libexec/meduza/meduza-lib.sh

report_status() {
	local kind=$1 name=$2 state=$3
	etcd_put "/updated/$MEDUZA_NODE/$kind/$name/status" "$state $(utc_now)"
}

openvpn_state() {
	local name=$1 conf="/etc/openvpn/meduza-$name.conf" dev
	dev=$(sed -n 's/^dev[[:space:]]\+//p' "$conf" 2>/dev/null | head -n1)
	if ! pgrep -f "openvpn.*meduza-$name.conf" >/dev/null 2>&1; then echo down
	elif [ -n "$dev" ] && ip link show "$dev" 2>/dev/null | grep -q 'UP'; then echo up
	else echo connecting
	fi
}

wireguard_state() {
	local name=$1 dev latest now
	dev=$(cat "$MEDUZA_STATE/wireguard.$name.dev" 2>/dev/null || true)
	[ -n "$dev" ] && ip link show "$dev" >/dev/null 2>&1 || { echo down; return; }
	latest=$(wg show "$dev" latest-handshakes 2>/dev/null | awk 'BEGIN{x=0} $2>x{x=$2} END{print x}')
	now=$(date +%s)
	if [ -z "$latest" ] || [ "$latest" = 0 ]; then echo connecting
	elif [ $((now - latest)) -le 180 ]; then echo up
	else echo connecting
	fi
}

main() {
	load_settings || exit 1
	while :; do
		lease=$(etcd_lease "$MEDUZA_TTL" 2>/dev/null || echo 0)
		[ "$lease" = 0 ] || etcd_put "/updated/$MEDUZA_NODE/online" 1 "$lease" || true
		for name in $(cat "$MEDUZA_STATE/openvpn.instances" 2>/dev/null); do report_status openvpn "$name" "$(openvpn_state "$name")" || true; done
		for name in $(cat "$MEDUZA_STATE/wireguard.instances" 2>/dev/null); do report_status wireguard "$name" "$(wireguard_state "$name")" || true; done
		if pgrep tincd >/dev/null 2>&1; then report_status tinc default up || true; else report_status tinc default down || true; fi
		if pgrep -f '/usr/lib/frr/(zebra|watchfrr)' >/dev/null 2>&1; then report_status frr default up || true; else report_status frr default down || true; fi
		sleep "$MEDUZA_REPORT"
	done
}

main "$@"
