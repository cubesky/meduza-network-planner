#!/bin/sh
set -e

# OpenWrt's /lib/functions.sh intentionally uses unset CONFIG_* variables.
IPKG_INSTROOT=${IPKG_INSTROOT:-}
. /lib/functions.sh
MEDUZA_LIBEXEC=${MEDUZA_LIBEXEC:-/usr/libexec/meduza}
. "$MEDUZA_LIBEXEC/meduza-lib.sh"

DESIRED=${1:-$MEDUZA_STATE/desired.interfaces}
MODE=${2:-apply}
TAB=$(printf '\t')
UCI_HELPER=$MEDUZA_LIBEXEC/meduza-uci-session.py
UCI_SESSION=''
CHANGED_INTERFACES="$MEDUZA_STATE/sync.changed.interfaces"
NETWORK_RELOAD_NEEDED="$MEDUZA_STATE/sync.network.reload-needed"
FIREWALL_RELOAD_NEEDED="$MEDUZA_STATE/sync.firewall.reload-needed"

cleanup_uci_session() {
	[ -z "$UCI_SESSION" ] || "$UCI_HELPER" "$UCI_SESSION" destroy >/dev/null 2>&1 || true
	UCI_SESSION=''
}
trap cleanup_uci_session EXIT
trap 'cleanup_uci_session; trap - EXIT; exit 130' INT
trap 'cleanup_uci_session; trap - EXIT; exit 143' TERM

start_uci_session() {
	command -v ubus >/dev/null 2>&1 || { log 'ubus is required for isolated UCI transactions'; return 1; }
	[ -x "$UCI_HELPER" ] || { log 'isolated UCI session helper is missing'; return 1; }
	UCI_SESSION=$("$UCI_HELPER" create network openvpn firewall) || return 1
	[ -n "$UCI_SESSION" ] || return 1
}

run_uci() { "$UCI_HELPER" "$UCI_SESSION" "$@"; }

optional_uci_get() {
	local value status
	if value=$(run_uci -q get "$1" 2>/dev/null); then
		printf '%s' "$value"
		return 0
	else
		status=$?
		[ "$status" -eq 3 ] && return 0
		return "$status"
	fi
}

delete_uci_if_present() {
	local status
	if run_uci -q delete "$1"; then
		return 0
	else
		status=$?
		[ "$status" -eq 3 ] && return 0
		return "$status"
	fi
}

package_changed() {
	local changes
	changes=$(run_uci changes "$1") || return 2
	[ -n "$changes" ]
}

install_changed_packages() {
	# Install all changed packages only after locking and validating the exact
	# current config inodes.  A concurrent CLI/LuCI commit either wins first and
	# aborts this CAS, or wins second and is preserved for the retry post-check.
	# The no-delta call is intentional: it promotes or rolls forward ownership
	# phases left after a commit/dir-fsync crash.
	run_uci install || return 1
}

# libuci keeps /tmp/.uci in its delta search path even when `uci -t` selects a
# different save directory.  Refuse to transact while another UCI client has
# pending changes, otherwise a commit here could accidentally apply that
# client's LuCI/CLI edits as well.
assert_default_uci_clean() {
	local package changes
	for package in network openvpn firewall; do
		if ! changes=$(uci -q changes "$package" 2>/dev/null); then
			# A missing optional package is clean; parse/I/O failures for an
			# existing package must never be treated as an empty delta.
			[ ! -e "/etc/config/$package" ] && continue
			log "could not inspect pending UCI $package changes"
			return 1
		fi
		[ -z "$changes" ] || {
			log "uncommitted UCI $package changes exist; apply or revert them before Meduza retries"
			return 1
		}
	done
}

managed_network_sections() {
	local logical shown legacy_logicals strong_file legacy_file candidates combined status
	strong_file="$MEDUZA_STATE/sync.owned-network.$$"
	legacy_file="$MEDUZA_STATE/sync.legacy-network.$$"
	candidates="$MEDUZA_STATE/sync.candidate-network.$$"
	combined="$MEDUZA_STATE/sync.managed-network.$$"
	shown=$(run_uci -q show network) || return 1
	printf '%s\n' "$shown" | sed -n \
		"s/^network\.\([^.=]*\)\.meduza_owner='$MEDUZA_OWNER'$/\1/p" >"$strong_file" || return 1
	legacy_authorized_logicals >"$legacy_file" || return 1
	: >"$combined"
	# Strong inline markers are only evidence; the helper must also match the
	# external ownership record (or strictly migrate an exact MANAGED row).
	# A legacy meduza=1 option additionally requires the generator's hashed
	# retirement authorization.  Never trust fresh DESIRED/PENDING rows.
	cat "$strong_file" "$legacy_file" >"$candidates" || return 1
	sort -u "$candidates" -o "$candidates" || return 1
	while IFS= read -r logical; do
			[ -n "$logical" ] || continue
			if network_section_is_owned "$logical"; then
				printf '%s\n' "$logical" >>"$combined" || return 1
			else
				status=$?
				[ "$status" -eq 1 ] || return "$status"
				if grep -qxF "$logical" "$strong_file"; then
					log "inline Meduza marker lacks external ownership: network.$logical"
					return 1
				fi
			fi
	done <"$candidates" || return 1
	sort -u "$combined"
	status=$?
	rm -f "$strong_file" "$legacy_file" "$candidates" "$combined"
	return "$status"
}

managed_openvpn_sections() {
	local shown logical candidates status
	[ -f /etc/config/openvpn ] || return 0
	shown=$(run_uci -q show openvpn) || return 1
	candidates=$(printf '%s\n' "$shown" | sed -n \
		"s/^openvpn\.\([^.=]*\)\.meduza_owner='$MEDUZA_OWNER'$/\1/p") || return 1
	for logical in $candidates; do
		if openvpn_section_is_owned "$logical"; then
			printf '%s\n' "$logical"
		else
			status=$?
			[ "$status" -eq 1 ] || return "$status"
			log "inline Meduza marker lacks external ownership: openvpn.$logical"
			return 1
		fi
	done
}

legacy_authorized_logicals() {
	[ -f "$MEDUZA_LEGACY_AUTH" ] || return 0
	awk -F '\t' 'NF == 6 { print $3 }' "$MEDUZA_LEGACY_AUTH"
}

historical_managed_logicals() {
	local file kind instance logical device config extra
	for file in "$MEDUZA_MANAGED" "$MEDUZA_PENDING"; do
		[ -f "$file" ] || continue
		while IFS="$TAB" read -r kind instance logical device config extra; do
			[ -z "$extra" ] || continue
			valid_managed_entry "$kind" "$instance" "$logical" "$device" "$config" || continue
			printf '%s\n' "$logical"
		done <"$file"
	done | sort -u
}

zone_sections() {
	local shown
	[ -f /etc/config/firewall ] || return 0
	shown=$(run_uci -q show firewall) || return 1
	printf '%s\n' "$shown" | sed -n "s/^firewall\.\([^.=]*\)=zone$/\1/p"
}

desired_has_logical() {
	local logical=$1
	[ -f "$DESIRED" ] || return 1
	awk -F '\t' -v value="$logical" '$3 == value { found=1 } END { exit !found }' "$DESIRED"
}

mark_interface_changed() {
	local logical=$1
	grep -qxF "$logical" "$CHANGED_INTERFACES" 2>/dev/null || \
		printf '%s\n' "$logical" >>"$CHANGED_INTERFACES"
}

set_network_type() {
	local logical=$1 value=$2 current
	current=$(optional_uci_get "network.$logical") || return 1
	[ "$current" = "$value" ] && return 0
	run_uci set "network.$logical=$value"
	mark_interface_changed "$logical"
}

set_network_option() {
	local logical=$1 option=$2 value=$3 current
	current=$(optional_uci_get "network.$logical.$option") || return 1
	[ "$current" = "$value" ] && return 0
	run_uci set "network.$logical.$option=$value"
	mark_interface_changed "$logical"
}

delete_network_option() {
	local logical=$1 option=$2 current
	current=$(optional_uci_get "network.$logical.$option") || return 1
	[ -n "$current" ] || return 0
	delete_uci_if_present "network.$logical.$option" || return 1
	mark_interface_changed "$logical"
}

set_openvpn_option() {
	local logical=$1 option=$2 value=$3 current
	current=$(optional_uci_get "openvpn.$logical.$option") || return 1
	[ "$current" = "$value" ] && return 0
	run_uci set "openvpn.$logical.$option=$value"
	mark_interface_changed "$logical"
}

find_zone() {
	local wanted=$1 section name found='' sections
	sections=$(zone_sections) || return 1
	for section in $sections; do
		name=$(optional_uci_get "firewall.$section.name") || return 1
		[ "$name" = "$wanted" ] || continue
		[ -z "$found" ] || { log "multiple firewall zones are named $wanted"; return 1; }
		found=$section
	done
	[ -n "$found" ] || return 1
	printf '%s' "$found"
}

network_section_is_owned() {
	local logical=$1 owner legacy kind instance recorded device config hash extra type proto actual status
	owner=$(optional_uci_get "network.$logical.meduza_owner") || return 2
	legacy=$(optional_uci_get "network.$logical.meduza") || return 2
	if [ "$owner" = "$MEDUZA_OWNER" ]; then
		if run_uci owned "network.$logical" >/dev/null 2>&1; then
			return 0
		else
			status=$?
			[ "$status" -eq 3 ] && return 1
			return 2
		fi
	fi
	[ -z "$owner" ] && [ "$legacy" = 1 ] || return 1
	type=$(optional_uci_get "network.$logical") || return 2
	proto=$(optional_uci_get "network.$logical.proto") || return 2
	device=$(optional_uci_get "network.$logical.device") || return 2
	[ "$type" = interface ] && [ "$proto" = none ] || return 1
	[ -f "$MEDUZA_LEGACY_AUTH" ] || return 1
	while IFS="$TAB" read -r kind instance recorded candidate config hash extra; do
			[ -z "$extra" ] && [ -n "$hash" ] || continue
			[ "$recorded" = "$logical" ] && [ "$candidate" = "$device" ] || continue
			valid_managed_entry "$kind" "$instance" "$recorded" "$candidate" "$config" || continue
			[ -f "$config" ] && [ ! -L "$config" ] && [ ! -L "${config%/*}" ] || continue
			actual=$(python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest())' "$config" 2>/dev/null) || return 2
			[ "$actual" = "$hash" ] && return 0
	done <"$MEDUZA_LEGACY_AUTH"
	return 1
}

openvpn_section_is_owned() {
	local logical=$1 owner status
	owner=$(optional_uci_get "openvpn.$logical.meduza_owner") || return 2
	[ "$owner" = "$MEDUZA_OWNER" ] || return 1
	if run_uci owned "openvpn.$logical" >/dev/null 2>&1; then
		return 0
	else
		status=$?
		[ "$status" -eq 3 ] && return 1
		return 2
	fi
}

historical_logical_can_remove() {
	local logical=$1 current status
	current=$(optional_uci_get "network.$logical") || return 2
	[ -n "$current" ] || return 0
	if network_section_is_owned "$logical"; then
		return 0
	else
		status=$?
	fi
	[ "$status" -eq 1 ] && return 1
	return 2
}

validate_manifest() {
	local kind instance logical device config extra type zone zone_count=0
	[ -f "$DESIRED" ] || : >"$DESIRED"
	while IFS="$TAB" read -r kind instance logical device config extra; do
		[ -n "$kind$instance$logical$device$config$extra" ] || continue
		[ -z "$extra" ] || { log 'invalid managed-interface manifest column count'; return 1; }
		valid_managed_entry "$kind" "$instance" "$logical" "$device" "$config" || {
			log "unsafe managed-interface record: $kind/$instance"; return 1;
		}
		[ "$MODE" != runtime-stop ] || continue
		case "$config" in "$MEDUZA_GENERATED"/*) :;; *) log "unsafe generated config path: $config"; return 1;; esac
		type=$(optional_uci_get "network.$logical") || return 1
		if [ -n "$type" ] && ! network_section_is_owned "$logical"; then
			log "refusing to replace user-owned network interface: $logical"
			return 1
		fi
		[ "$(awk -F '\t' -v value="$logical" '$3 == value { count++ } END { print count+0 }' "$DESIRED")" -eq 1 ] || {
			log "duplicate UCI VPN interface: $logical"; return 1;
		}
		[ "$(awk -F '\t' -v value="$device" '$4 == value { count++ } END { print count+0 }' "$DESIRED")" -eq 1 ] || {
			log "duplicate VPN device: $device"; return 1;
		}
		if [ "$kind" = openvpn ]; then
			if [ ! -f /lib/netifd/proto/openvpn.sh ] && \
				{ [ -e "/etc/openvpn/$logical.conf" ] || [ -L "/etc/openvpn/$logical.conf" ]; }; then
				log "OpenVPN path instance conflicts with Meduza logical name: $logical"
				return 1
			fi
			if [ -f /etc/config/openvpn ]; then
				type=$(optional_uci_get "openvpn.$logical") || return 1
				[ -z "$type" ] || openvpn_section_is_owned "$logical" || {
					log "refusing to replace user-owned OpenVPN instance: $logical"; return 1;
				}
			fi
		fi
	done <"$DESIRED"
	case "$MODE" in runtime-stop|preflight) return 0;; esac

	config_load meduza
	config_get zone main VPN_FIREWALL_ZONE
	if [ -n "$zone" ] && [ -s "$DESIRED" ] && [ -f /etc/config/firewall ]; then
		find_zone "$zone" >/dev/null || { log "VPN_FIREWALL_ZONE does not exist or is ambiguous: $zone"; return 1; }
	elif [ -n "$zone" ] && [ -s "$DESIRED" ]; then
		log 'firewall is not installed; VPN_FIREWALL_ZONE will be skipped'
	fi
}

ensure_network_interface() {
	local kind=$1 instance=$2 logical=$3 device=$4 config=$5 proto current
	proto=none
	[ "$kind" != openvpn ] || [ ! -f /lib/netifd/proto/openvpn.sh ] || proto=openvpn
	current=$(optional_uci_get "network.$logical") || return 1
	[ -z "$current" ] || network_section_is_owned "$logical" || {
		log "refusing concurrent replacement of user-owned network interface: $logical"
		return 1
	}
	set_network_type "$logical" interface
	set_network_option "$logical" proto "$proto"
	set_network_option "$logical" auto 0
	set_network_option "$logical" defaultroute 0
	set_network_option "$logical" peerdns 0
	set_network_option "$logical" delegate 0
	set_network_option "$logical" meduza_owner "$MEDUZA_OWNER"
	set_network_option "$logical" meduza_kind "$kind"
	set_network_option "$logical" meduza_instance "$instance"
	set_network_option "$logical" meduza_device "$device"
	set_network_option "$logical" meduza_config "$config"
	delete_network_option "$logical" meduza
	if [ "$proto" = openvpn ]; then
		set_network_option "$logical" config "$config"
		set_network_option "$logical" script_security 3
		set_network_option "$logical" up "${config%/*}/link-up"
		delete_network_option "$logical" device
	else
		set_network_option "$logical" device "$device"
		delete_network_option "$logical" config
		delete_network_option "$logical" script_security
		delete_network_option "$logical" up
	fi
}

ensure_legacy_openvpn() {
	local logical=$1 device=$2 config=$3 current
	current=$(optional_uci_get "openvpn.$logical") || return 1
	[ -z "$current" ] || openvpn_section_is_owned "$logical" || {
		log "refusing concurrent replacement of user-owned OpenVPN instance: $logical"
		return 1
	}
	if [ "$current" != openvpn ]; then
		run_uci set "openvpn.$logical=openvpn"
		mark_interface_changed "$logical"
	fi
	set_openvpn_option "$logical" enabled 1
	set_openvpn_option "$logical" config "$config"
	set_openvpn_option "$logical" dev "$device"
	set_openvpn_option "$logical" meduza_owner "$MEDUZA_OWNER"
}

remove_legacy_openvpn_if_native() {
	local logical=$1 current
	[ -f /etc/config/openvpn ] || return 0
	current=$(optional_uci_get "openvpn.$logical") || return 1
	[ -n "$current" ] || return 0
	openvpn_section_is_owned "$logical" || return 1
	delete_uci_if_present "openvpn.$logical" || return 1
	mark_interface_changed "$logical"
}

disable_owned_legacy_openvpn() {
	local kind instance logical device config extra sections current section_config section_device
	[ -f /etc/config/openvpn ] || return 0
	sections=$(managed_openvpn_sections) || return 1
	for logical in $sections; do
		current=$(optional_uci_get "openvpn.$logical") || return 1
		[ "$current" = openvpn ] || {
			log "owner-marked OpenVPN section has invalid type: $logical"; return 1;
		}
		set_openvpn_option "$logical" enabled 0
	done
	while IFS="$TAB" read -r kind instance logical device config extra; do
		[ "$kind" = openvpn ] || continue
		openvpn_section_is_owned "$logical" || continue
		section_config=$(optional_uci_get "openvpn.$logical.config") || return 1
		section_device=$(optional_uci_get "openvpn.$logical.dev") || return 1
		[ "$section_config" = "$config" ] || continue
		[ "$section_device" = "$device" ] || continue
		set_openvpn_option "$logical" enabled 0
	done <"$DESIRED"
}

rewrite_zone_members() {
	local section=$1 remove=$2 add=$3
	if [ -n "$add" ]; then
		run_uci edge_add "firewall.$section.network=$add"
	else
		run_uci edge_del "firewall.$section.network=$remove"
	fi
}

sync_firewall_membership() {
	local desired_logicals=$1 target=$2 previous_managed=${3:-} section logical add sections managed historical status logical_file
	[ -f /etc/config/firewall ] || return 0
	sections=$(zone_sections) || return 1
	managed=$(managed_network_sections) || return 1
	historical=$(historical_managed_logicals) || return 1
	logical_file="$MEDUZA_STATE/sync.firewall-logicals.$$"
	: >"$logical_file" || return 1
	for logical in $previous_managed $managed $historical $desired_logicals; do
		[ -n "$logical" ] || continue
		printf '%s\n' "$logical" >>"$logical_file" || { rm -f "$logical_file"; return 1; }
	done
	sort -u "$logical_file" -o "$logical_file" || { rm -f "$logical_file"; return 1; }
	for section in $sections; do
		# previous_managed is captured before stale network sections are removed
		# from the private UCI transaction.  Without it, an empty desired set
		# loses the only name by which the old firewall membership can be removed.
		while IFS= read -r logical; do
			[ -n "$logical" ] || continue
			add=''
			[ "$section" = "$target" ] && desired_has_logical "$logical" && add=$logical
			if [ -z "$add" ]; then
				if historical_logical_can_remove "$logical"; then
					:
				else
					status=$?
					[ "$status" -eq 1 ] && continue
					rm -f "$logical_file"
					return "$status"
				fi
			fi
			rewrite_zone_members "$section" "$logical" "$add" || {
				rm -f "$logical_file"; return 1;
			}
		done <"$logical_file"
	done
	rm -f "$logical_file" || return 1
}

apply_sync() {
	local kind instance logical device config extra existing zone zone_section='' desired_logicals='' sections managed_before
	assert_default_uci_clean
	start_uci_session
	validate_manifest
	case "$MODE" in validate|preflight) return 0;; esac
	if [ "$MODE" = runtime-stop ]; then
		disable_owned_legacy_openvpn
		[ -f /etc/config/openvpn ] || return 0
		assert_default_uci_clean
		if package_changed openvpn; then
			OPENVPN_CHANGED=1
		else
			[ "$?" -eq 1 ] || return 1
			OPENVPN_CHANGED=''
		fi
		install_changed_packages
		fsync /etc/config || { log 'could not durably commit disabled OpenVPN state'; return 1; }
		return 0
	fi
	[ "$MODE" = apply ] || { log "invalid OpenWrt sync mode: $MODE"; return 2; }
	managed_before=$(managed_network_sections) || return 1

	config_load meduza
	config_get zone main VPN_FIREWALL_ZONE
	[ ! -s "$DESIRED" ] || [ -z "$zone" ] || [ ! -f /etc/config/firewall ] || zone_section=$(find_zone "$zone")

	while IFS="$TAB" read -r kind instance logical device config extra; do
		[ -n "$kind$instance$logical$device$config" ] || continue
		ensure_network_interface "$kind" "$instance" "$logical" "$device" "$config"
		desired_logicals="$desired_logicals $logical"
		if [ "$kind" = openvpn ]; then
			if [ -f /lib/netifd/proto/openvpn.sh ]; then
				remove_legacy_openvpn_if_native "$logical"
			elif [ -x /etc/init.d/openvpn ]; then
				ensure_legacy_openvpn "$logical" "$device" "$config"
			fi
		fi
	done <"$DESIRED"

	for existing in $managed_before; do
		desired_has_logical "$existing" && continue
		delete_uci_if_present "network.$existing" || return 1
		mark_interface_changed "$existing"
	done
	sections=$(managed_openvpn_sections) || return 1
	for existing in $sections; do
		desired_has_logical "$existing" && [ ! -f /lib/netifd/proto/openvpn.sh ] && continue
		delete_uci_if_present "openvpn.$existing" || return 1
		mark_interface_changed "$existing"
	done

	sync_firewall_membership "${desired_logicals# }" "$zone_section" "$managed_before"
	# Close the window in which a LuCI/CLI session could have staged edits while
	# this process prepared its isolated delta.
	assert_default_uci_clean

	if package_changed network; then NETWORK_CHANGED=1; else [ "$?" -eq 1 ] || return 1; NETWORK_CHANGED=''; fi
	if package_changed openvpn; then OPENVPN_CHANGED=1; else [ "$?" -eq 1 ] || return 1; OPENVPN_CHANGED=''; fi
	if package_changed firewall; then FIREWALL_CHANGED=1; else [ "$?" -eq 1 ] || return 1; FIREWALL_CHANGED=''; fi
	[ -z "$NETWORK_CHANGED" ] || : >"$NETWORK_RELOAD_NEEDED"
	[ -z "$FIREWALL_CHANGED" ] || : >"$FIREWALL_RELOAD_NEEDED"
	install_changed_packages
	# A retry can observe files already renamed by rpcd after the previous
	# directory fsync failed.  Always close that durability window, including
	# the no-delta path, before the generator publishes its manifest/cache.
	fsync /etc/config || { log 'could not durably commit UCI configuration'; return 1; }

	if [ -f "$NETWORK_RELOAD_NEEDED" ]; then
		if command -v ubus >/dev/null 2>&1; then
			ubus call network reload >/dev/null || { log 'network reload failed'; return 1; }
			rm -f "$NETWORK_RELOAD_NEEDED"
		else
			log 'ubus is not installed; cannot activate changed network interfaces'
			return 1
		fi
	fi
	if [ -f "$FIREWALL_RELOAD_NEEDED" ]; then
		if [ -x /etc/init.d/firewall ]; then
			/etc/init.d/firewall reload >/dev/null || { log 'firewall reload failed'; return 1; }
			rm -f "$FIREWALL_RELOAD_NEEDED"
		else
			log 'firewall service is not installed; firewall reload skipped'
			rm -f "$FIREWALL_RELOAD_NEEDED"
		fi
	fi
	if [ -z "$NETWORK_CHANGED$FIREWALL_CHANGED$OPENVPN_CHANGED" ]; then
		log 'OpenWrt VPN interfaces already synchronized; no reload needed'
	else
		log "OpenWrt VPN interfaces synchronized; firewall zone=${zone:-none}"
	fi
}

apply_sync
