quiesce() {
	local status attempt=0 quiet=0
	[ ! -x /etc/init.d/meduza ] || /etc/init.d/meduza stop >/dev/null 2>&1 || true
	if agent_registration_owned; then
		ubus -S call service delete '{"name":"meduza","instance":"agent"}' >/dev/null 2>&1 || return 1
	else
		status=$?
		[ "$status" -eq 1 ] || return 1
	fi
	signal_owned_processes TERM
	while [ "$attempt" -lt 15 ]; do
		if agent_registration_owned; then
			quiet=0
		else
			status=$?
			[ "$status" -eq 1 ] || return 1
			if controller_live; then quiet=0; else quiet=$((quiet + 1)); fi
		fi
		[ "$quiet" -ge 2 ] && return 0
		attempt=$((attempt + 1))
		[ "$attempt" -ne 8 ] || signal_owned_processes KILL
		sleep 1
	done
	return 1
}

retry_purge() {
	# A crash after the purge payload succeeded may leave only the deletion
	# journal.  Finish that replay without requiring the already-moved bundle.
	if bundle_record_nonce deleting >/dev/null 2>&1 || \
		bundle_record_nonce deleting-legacy >/dev/null 2>&1; then
		remove_bundle
		return $?
	fi
	bundle_record_owned && bundle_dir_owned || return 1
	quiesce || return 1
	MEDUZA_LIBEXEC=$BUNDLE
	export MEDUZA_LIBEXEC
	"$BUNDLE/meduza-generator" --purge || return 1
	remove_install_completion || return 1
	remove_bundle
}

case "${1:-}" in
	--install-bundle) install_bundle;;
	--remove-bundle) remove_bundle;;
	--purge) retry_purge;;
	*) echo 'usage: meduza-recover --install-bundle|--remove-bundle|--purge' >&2; exit 2;;
esac
