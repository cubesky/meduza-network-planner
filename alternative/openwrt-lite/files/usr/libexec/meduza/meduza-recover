#!/bin/sh
set -e

# apk-tools records package-script failures but may still remove the payload.
# Keep an owner-marked copy of the purge implementation so cleanup can be
# retried after a package-script failure while its Python/UCI runtime
# dependencies remain installed.  The README documents the reinstall-first
# recovery path when apk also removes those dependencies.
SOURCE_DIR=${MEDUZA_LIBEXEC:-/usr/libexec/meduza}
DATA=${MEDUZA_DATA:-/etc/meduza}
MANAGED=$DATA/managed
BUNDLE=$DATA/recovery
RECORD=$MANAGED/recovery.bundle
OWNER=meduza-openwrt-lite-recovery-v1
FILES='meduza-generator meduza-lib.sh meduza-json.py meduza-uci-session.py meduza-openwrt-sync meduza-recover'
TAB=$(printf '\t')

atomic_value() {
	local target=$1 value=$2 tmp=${1}.meduza.$$
	[ ! -L "$target" ] || return 1
	rm -f "$tmp" || return 1
	printf '%s\n' "$value" >"$tmp" || return 1
	chmod 600 "$tmp" || return 1
	fsync "$tmp" || return 1
	mv -f "$tmp" "$target" || return 1
	fsync "${target%/*}" || return 1
}

bundle_record_owned() {
	local nonce
	[ -f "$RECORD" ] && [ ! -L "$RECORD" ] || return 1
	[ "$(cat "$RECORD" 2>/dev/null || true)" = "$OWNER" ] && return 0
	nonce=$(bundle_record_nonce owned) || return 1
	[ -n "$nonce" ]
}

bundle_record_nonce() {
	local expected_phase=$1 line old_ifs version owner nonce phase extra
	[ -f "$RECORD" ] && [ ! -L "$RECORD" ] || return 1
	line=$(cat "$RECORD" 2>/dev/null) || return 1
	old_ifs=$IFS
	IFS=$TAB
	set -- $line
	IFS=$old_ifs
	[ "$#" -eq 4 ] || return 1
	version=$1
	owner=$2
	nonce=$3
	phase=$4
	[ "$version" = v2 ] && [ "$owner" = "$OWNER" ] && \
		[ "$phase" = "$expected_phase" ] || return 1
	case "$nonce" in ''|*[!0-9a-f]*) return 1;; esac
	[ "${#nonce}" -eq 32 ] || return 1
	printf '%s' "$nonce"
}

bundle_creation_nonce() {
	bundle_record_nonce creating
}

bundle_legacy_empty_nonce() {
	bundle_record_nonce legacy-empty
}

bundle_owner_value() {
	local nonce
	if [ -f "$RECORD" ] && [ ! -L "$RECORD" ] && \
		[ "$(cat "$RECORD" 2>/dev/null || true)" = "$OWNER" ]; then
		printf '%s' "$OWNER"
		return 0
	fi
	if nonce=$(bundle_record_nonce creating); then
		printf '%s:%s' "$OWNER" "$nonce"
		return 0
	fi
	nonce=$(bundle_record_nonce owned) || return 1
	printf '%s:%s' "$OWNER" "$nonce"
}

new_nonce() {
	python3 -c 'import secrets; print(secrets.token_hex(16))'
}

rename_noreplace() {
	local source=$1 target=$2
	[ ! -e "$target" ] && [ ! -L "$target" ] || return 1
	# Package scripts are serialized by apk/opkg.  BusyBox mv's -n prevents a
	# same-name object from being overwritten; the source-absence check also
	# distinguishes its successful no-op result if the target already exists.
	# -T is essential here: without it, a concurrently-created directory at the
	# target path would receive the stage as a child instead of being rejected.
	mv -nT "$source" "$target" || return 1
	[ ! -e "$source" ] && [ ! -L "$source" ] || return 1
}

bundle_dir_owned_at() {
	local directory=$1 owner_value
	local file expected actual seen=0 seen_files=
	owner_value=$(bundle_owner_value) || return 1
	[ -d "$directory" ] && [ ! -L "$directory" ] && \
		[ -f "$directory/.meduza-owner" ] && [ ! -L "$directory/.meduza-owner" ] && \
		[ "$(cat "$directory/.meduza-owner" 2>/dev/null || true)" = "$owner_value" ] && \
		[ -f "$directory/.meduza-ready" ] && [ ! -L "$directory/.meduza-ready" ] || return 1
	while IFS="$(printf '\t')" read -r expected file extra; do
		[ -z "$extra" ] && [ -n "$expected" ] && [ -n "$file" ] || return 1
		case "$file" in meduza-generator|meduza-lib.sh|meduza-json.py|meduza-uci-session.py|meduza-openwrt-sync|meduza-recover) :;; *) return 1;; esac
		case " $seen_files " in *" $file "*) return 1;; esac
		seen_files="$seen_files $file"
		case "$expected" in *[!0-9a-f]*|'') return 1;; esac
		[ "${#expected}" -eq 64 ] || return 1
		[ -f "$directory/$file" ] && [ ! -L "$directory/$file" ] || return 1
		actual=$(sha256sum "$directory/$file") || return 1
		actual=${actual%% *}
		[ "$actual" = "$expected" ] || return 1
		seen=$((seen + 1))
	done <"$directory/.meduza-ready"
	[ "$seen" -eq 6 ] || return 1
	for file in $FILES; do
		case " $seen_files " in *" $file "*) :;; *) return 1;; esac
	done
	# A valid ready manifest proves the required files, not the absence of an
	# administrator's extra file.  Ownership requires both properties.
	bundle_entries_known_at "$directory" || return 1
}

bundle_dir_owned() {
	bundle_dir_owned_at "$BUNDLE"
}

cleanup_bundle_temps() {
	local directory=$1 temporary file owner_value
	owner_value=$(bundle_owner_value) || return 1
	[ -f "$directory/.meduza-owner" ] && [ ! -L "$directory/.meduza-owner" ] && \
		[ "$(cat "$directory/.meduza-owner" 2>/dev/null || true)" = "$owner_value" ] || return 1
	for temporary in "$directory/.meduza-owner.meduza."[0-9]* \
		"$directory/.meduza-ready.meduza."[0-9]*; do
		[ -e "$temporary" ] || [ -L "$temporary" ] || continue
		[ -f "$temporary" ] && [ ! -L "$temporary" ] || return 1
		rm -f "$temporary" || return 1
	done
	for file in $FILES; do
		for temporary in "$directory/$file.meduza."[0-9]*; do
			[ -e "$temporary" ] || [ -L "$temporary" ] || continue
			[ -f "$temporary" ] && [ ! -L "$temporary" ] || return 1
			rm -f "$temporary" || return 1
		done
	done
	fsync "$directory" || return 1
}

cleanup_owned_temps() {
	local temporary
	bundle_record_owned || return 1
	cleanup_bundle_temps "$BUNDLE" || return 1
	for temporary in "$RECORD.meduza."[0-9]*; do
		[ -e "$temporary" ] || [ -L "$temporary" ] || continue
		[ -f "$temporary" ] && [ ! -L "$temporary" ] || return 1
		rm -f "$temporary" || return 1
	done
	fsync "$MANAGED" || return 1
}

bundle_entries_known_at() {
	local directory=$1 entry base file allowed
	for entry in "$directory"/* "$directory"/.[!.]* "$directory"/..?*; do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		base=${entry##*/}
		allowed=0
		case "$base" in .meduza-owner|.meduza-ready) allowed=1;; esac
		for file in $FILES; do [ "$base" = "$file" ] && allowed=1; done
		[ "$allowed" -eq 1 ] || return 1
		[ -f "$entry" ] && [ ! -L "$entry" ] || return 1
	done
}

bundle_entries_known() {
	bundle_entries_known_at "$BUNDLE"
}

promote_owner_temp() {
	local directory=$1 expected_owner=$2 entry base suffix temporary= count=0
	[ -d "$directory" ] && [ ! -L "$directory" ] || return 1
	[ ! -e "$directory/.meduza-owner" ] && \
		[ ! -L "$directory/.meduza-owner" ] || return 1
	for entry in "$directory"/* "$directory"/.[!.]* "$directory"/..?*; do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		[ "$entry" != "$temporary" ] || continue
		base=${entry##*/}
		case "$base" in .meduza-owner.meduza.*) :;; *) return 1;; esac
		suffix=${base#.meduza-owner.meduza.}
		case "$suffix" in ''|*[!0-9]*) return 1;; esac
		[ -f "$entry" ] && [ ! -L "$entry" ] && \
			[ "$(cat "$entry" 2>/dev/null || true)" = "$expected_owner" ] || return 1
		count=$((count + 1))
		temporary=$entry
	done
	[ "$count" -eq 1 ] || return 1
	mv -f "$temporary" "$directory/.meduza-owner" || return 1
	fsync "$directory" || return 1
}

directory_empty() {
	local directory=$1 entry
	[ -d "$directory" ] && [ ! -L "$directory" ] || return 1
	for entry in "$directory"/* "$directory"/.[!.]* "$directory"/..?*; do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		return 1
	done
	return 0
}

prepare_creation_stage() {
	local nonce=$1 stage=$DATA/.meduza-recovery.$1 owner_value
	owner_value=$(bundle_owner_value) || return 1
	if [ -e "$stage" ] || [ -L "$stage" ]; then
		[ -d "$stage" ] && [ ! -L "$stage" ] || return 1
	else
		mkdir "$stage" || return 1
		chmod 700 "$stage" || return 1
		fsync "$DATA" || return 1
	fi
	if [ ! -e "$stage/.meduza-owner" ] && [ ! -L "$stage/.meduza-owner" ]; then
		if directory_empty "$stage"; then
			# The unguessable stage path is bound by the already-durable external
			# nonce record, so an empty interrupted mkdir can be completed safely.
			atomic_value "$stage/.meduza-owner" "$owner_value" || return 1
		else
			# Legacy atomic_value may have persisted its exact owner temp without
			# completing the rename.  Accept only that single proof-bearing file.
			promote_owner_temp "$stage" "$owner_value" || return 1
		fi
	fi
	[ -f "$stage/.meduza-owner" ] && [ ! -L "$stage/.meduza-owner" ] && \
		[ "$(cat "$stage/.meduza-owner" 2>/dev/null || true)" = "$owner_value" ] || return 1
	cleanup_bundle_temps "$stage" || return 1
	bundle_entries_known_at "$stage" || return 1
	printf '%s' "$stage"
}

populate_bundle_at() {
	local directory=$1 file source temporary hash ready
	cleanup_bundle_temps "$directory" || return 1
	bundle_entries_known_at "$directory" || return 1
	rm -f "$directory/.meduza-ready" || return 1
	fsync "$directory" || return 1
	for file in $FILES; do
		source=$SOURCE_DIR/$file
		[ -f "$source" ] && [ ! -L "$source" ] || return 1
		temporary=$directory/$file.meduza.$$
		rm -f "$temporary" || return 1
		cp "$source" "$temporary" || return 1
		chmod 700 "$temporary" || return 1
		fsync "$temporary" || return 1
		mv -f "$temporary" "$directory/$file" || return 1
		fsync "$directory" || return 1
	done
	ready=$directory/.meduza-ready.meduza.$$
	: >"$ready" || return 1
	for file in $FILES; do
		hash=$(sha256sum "$directory/$file") || return 1
		hash=${hash%% *}
		printf '%s\t%s\n' "$hash" "$file" >>"$ready" || return 1
	done
	chmod 600 "$ready" || return 1
	fsync "$ready" || return 1
	mv -f "$ready" "$directory/.meduza-ready" || return 1
	fsync "$directory" || return 1
	bundle_entries_known_at "$directory" || return 1
	bundle_dir_owned_at "$directory" || return 1
}

resume_bundle_creation() {
	local nonce=$1 stage owned_value
	owned_value=$(printf 'v2\t%s\t%s\towned' "$OWNER" "$nonce") || return 1
	stage=$DATA/.meduza-recovery.$nonce
	if [ -e "$BUNDLE" ] || [ -L "$BUNDLE" ]; then
		# The only valid target under a creation record is the complete stage
		# after its atomic publication.  Never merge with or adopt another tree.
		[ ! -e "$stage" ] && [ ! -L "$stage" ] || return 1
		bundle_dir_owned || return 1
		atomic_value "$RECORD" "$owned_value" || return 1
		return 0
	fi
	stage=$(prepare_creation_stage "$nonce") || return 1
	populate_bundle_at "$stage" || return 1
	rename_noreplace "$stage" "$BUNDLE" || return 1
	fsync "$DATA" || return 1
	bundle_dir_owned || return 1
	atomic_value "$RECORD" "$owned_value" || return 1
}

begin_bundle_creation() {
	local nonce value stage
	nonce=$(new_nonce) || return 1
	case "$nonce" in ''|*[!0-9a-f]*) return 1;; esac
	[ "${#nonce}" -eq 32 ] || return 1
	stage=$DATA/.meduza-recovery.$nonce
	# Do not publish an ownership intent over a pre-existing target or the
	# nonce path.  Only paths created after the durable record are authorized.
	[ ! -e "$BUNDLE" ] && [ ! -L "$BUNDLE" ] && \
		[ ! -e "$stage" ] && [ ! -L "$stage" ] || return 1
	value=$(printf 'v2\t%s\t%s\tcreating' "$OWNER" "$nonce") || return 1
	atomic_value "$RECORD" "$value" || return 1
	resume_bundle_creation "$nonce"
}

resume_legacy_empty_creation() {
	local nonce=$1 stage=$DATA/.meduza-recovery.$1 creating_value
	if [ -e "$BUNDLE" ] || [ -L "$BUNDLE" ]; then
		[ ! -e "$stage" ] && [ ! -L "$stage" ] || return 1
		[ -d "$BUNDLE" ] && [ ! -L "$BUNDLE" ] || return 1
		# The legacy r27 failure window left exactly an empty final directory.
		# Remove and durably forget that unowned object; normal creation will make
		# a fresh nonce-bound stage only after the phase advances to creating.
		directory_empty "$BUNDLE" || return 1
		rmdir "$BUNDLE" || return 1
		fsync "$DATA" || return 1
	else
		# A legacy-empty phase never creates the stage.  Both paths absent is the
		# expected crash state after the empty target was durably removed.
		[ ! -e "$stage" ] && [ ! -L "$stage" ] || return 1
	fi
	creating_value=$(printf 'v2\t%s\t%s\tcreating' "$OWNER" "$nonce") || return 1
	atomic_value "$RECORD" "$creating_value" || return 1
	resume_bundle_creation "$nonce"
}

begin_legacy_empty_creation() {
	local nonce value stage
	nonce=$(new_nonce) || return 1
	case "$nonce" in ''|*[!0-9a-f]*) return 1;; esac
	[ "${#nonce}" -eq 32 ] || return 1
	stage=$DATA/.meduza-recovery.$nonce
	[ -d "$BUNDLE" ] && [ ! -L "$BUNDLE" ] && \
		directory_empty "$BUNDLE" && \
		[ ! -e "$stage" ] && [ ! -L "$stage" ] || return 1
	value=$(printf 'v2\t%s\t%s\tlegacy-empty' "$OWNER" "$nonce") || return 1
	atomic_value "$RECORD" "$value" || return 1
	resume_legacy_empty_creation "$nonce"
}

install_bundle() {
	local nonce
	umask 077
	[ ! -L "$DATA" ] && [ ! -L "$MANAGED" ] || return 1
	mkdir -p "$MANAGED" || return 1
	chmod 700 "$DATA" "$MANAGED" || return 1
	fsync "$DATA" || return 1
	fsync "$MANAGED" || return 1
	# A purge may have committed its nonce-bound delete journal immediately
	# before apk fix/reinstall asks us to install the bundle again.  Finish that
	# exact deletion first, then publish an entirely new bundle generation.
	if nonce=$(bundle_record_nonce deleting); then
		resume_bundle_deletion "$nonce" deleting "$OWNER:$nonce" || return 1
		begin_bundle_creation
		return $?
	fi
	if nonce=$(bundle_record_nonce deleting-legacy); then
		resume_bundle_deletion "$nonce" deleting-legacy "$OWNER" || return 1
		begin_bundle_creation
		return $?
	fi
	if [ -e "$RECORD" ] || [ -L "$RECORD" ]; then
		if nonce=$(bundle_creation_nonce); then
			resume_bundle_creation "$nonce"
			return $?
		fi
		if nonce=$(bundle_legacy_empty_nonce); then
			resume_legacy_empty_creation "$nonce"
			return $?
		fi
		bundle_record_owned || return 1
	else
		begin_bundle_creation
		return $?
	fi
	if [ ! -e "$BUNDLE" ] && [ ! -L "$BUNDLE" ]; then
		# Upgrade the legacy constant intent to a nonce-bound staged creation.
		begin_bundle_creation
		return $?
	fi
	[ -d "$BUNDLE" ] && [ ! -L "$BUNDLE" ] || return 1
	if ! bundle_dir_owned; then
		if [ ! -e "$BUNDLE/.meduza-owner" ] && [ ! -L "$BUNDLE/.meduza-owner" ]; then
			if directory_empty "$BUNDLE"; then
				begin_legacy_empty_creation
				return $?
			fi
			promote_owner_temp "$BUNDLE" "$OWNER" || return 1
		fi
		[ -f "$BUNDLE/.meduza-owner" ] && [ ! -L "$BUNDLE/.meduza-owner" ] && \
			[ "$(cat "$BUNDLE/.meduza-owner" 2>/dev/null || true)" = "$OWNER" ] || return 1
	fi
	cleanup_owned_temps || return 1
	populate_bundle_at "$BUNDLE"
}

remove_install_completion() {
	local complete=$MANAGED/install-complete temporary
	[ ! -L "$complete" ] || return 1
	rm -f "$complete" || return 1
	for temporary in "$complete.meduza."[0-9]*; do
		[ -e "$temporary" ] || [ -L "$temporary" ] || continue
		[ -f "$temporary" ] && [ ! -L "$temporary" ] || return 1
		rm -f "$temporary" || return 1
	done
	fsync "$MANAGED" || return 1
}

deletion_source_safe() {
	local directory=$1 expected_owner=$2
	[ -d "$directory" ] && [ ! -L "$directory" ] || return 1
	if [ -e "$directory/.meduza-owner" ] || [ -L "$directory/.meduza-owner" ]; then
		[ -f "$directory/.meduza-owner" ] && \
			[ ! -L "$directory/.meduza-owner" ] && \
			[ "$(cat "$directory/.meduza-owner" 2>/dev/null || true)" = "$expected_owner" ] || return 1
		# A prior release could have been interrupted after deleting any subset
		# of the known files.  The exact owner proof plus this allowlist makes
		# that state safe to journal and resume without requiring .meduza-ready.
		bundle_entries_known_at "$directory" || return 1
		return 0
	fi
	# The previous in-place remover deleted the owner last.  Once that proof is
	# absent, only a strictly empty directory is a recoverable legacy state.
	directory_empty "$directory"
}

deletion_tomb_remove_known() {
	local tomb=$1 entry file
	for file in $FILES; do
		entry=$tomb/$file
		if [ -e "$entry" ] || [ -L "$entry" ]; then
			[ -f "$entry" ] && [ ! -L "$entry" ] || return 1
			rm -f "$entry" || return 1
			fsync "$tomb" || return 1
		fi
	done
	entry=$tomb/.meduza-ready
	if [ -e "$entry" ] || [ -L "$entry" ]; then
		[ -f "$entry" ] && [ ! -L "$entry" ] || return 1
		rm -f "$entry" || return 1
		fsync "$tomb" || return 1
	fi
}

deletion_tomb_only_owner() {
	local tomb=$1 expected_owner=$2 entry base
	[ -f "$tomb/.meduza-owner" ] && [ ! -L "$tomb/.meduza-owner" ] && \
		[ "$(cat "$tomb/.meduza-owner" 2>/dev/null || true)" = "$expected_owner" ] || return 1
	for entry in "$tomb"/* "$tomb"/.[!.]* "$tomb"/..?*; do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		base=${entry##*/}
		[ "$base" = .meduza-owner ] || return 1
		[ -f "$entry" ] && [ ! -L "$entry" ] || return 1
	done
}

resume_bundle_deletion() {
	local nonce=$1 phase=$2 expected_owner=$3 tomb=$DATA/.meduza-recovery-delete.$1 recorded
	recorded=$(bundle_record_nonce "$phase") || return 1
	[ "$recorded" = "$nonce" ] || return 1
	case "$phase:$expected_owner" in
		"deleting:$OWNER:$nonce"|"deleting-legacy:$OWNER") :;;
		*) return 1;;
	esac
	if [ -e "$BUNDLE" ] || [ -L "$BUNDLE" ]; then
		[ ! -e "$tomb" ] && [ ! -L "$tomb" ] || return 1
		deletion_source_safe "$BUNDLE" "$expected_owner" || return 1
		rename_noreplace "$BUNDLE" "$tomb" || return 1
		fsync "$DATA" || return 1
	elif [ ! -e "$tomb" ] && [ ! -L "$tomb" ]; then
		# The tomb directory was already durably removed; the external journal
		# is deliberately cleared last so this completion window is replayable.
		rm -f "$RECORD" || return 1
		fsync "$MANAGED" || return 1
		return 0
	fi
	[ -d "$tomb" ] && [ ! -L "$tomb" ] || return 1
	if [ -e "$tomb/.meduza-owner" ] || [ -L "$tomb/.meduza-owner" ]; then
		[ -f "$tomb/.meduza-owner" ] && [ ! -L "$tomb/.meduza-owner" ] && \
			[ "$(cat "$tomb/.meduza-owner" 2>/dev/null || true)" = "$expected_owner" ] || return 1
		# Refuse unknown entries and dangling links before deleting another byte.
		# Missing known files and a missing ready manifest are valid crash states.
		bundle_entries_known_at "$tomb" || return 1
		deletion_tomb_remove_known "$tomb" || return 1
		deletion_tomb_only_owner "$tomb" "$expected_owner" || return 1
		rm -f "$tomb/.meduza-owner" || return 1
		fsync "$tomb" || return 1
	else
		# Owner is removed last.  Without it, only the resulting empty tomb may
		# be replayed; any regular file or dangling symlink is foreign content.
		directory_empty "$tomb" || return 1
	fi
	rmdir "$tomb" || return 1
	fsync "$DATA" || return 1
	rm -f "$RECORD" || return 1
	fsync "$MANAGED" || return 1
}

remove_bundle() {
	local nonce phase expected_owner value
	if nonce=$(bundle_record_nonce deleting); then
		resume_bundle_deletion "$nonce" deleting "$OWNER:$nonce"
		return $?
	fi
	if nonce=$(bundle_record_nonce deleting-legacy); then
		resume_bundle_deletion "$nonce" deleting-legacy "$OWNER"
		return $?
	fi
	[ ! -e "$RECORD" ] && [ ! -L "$RECORD" ] && \
		[ ! -e "$BUNDLE" ] && [ ! -L "$BUNDLE" ] && return 0
	bundle_record_owned || return 1
	if [ ! -e "$BUNDLE" ] && [ ! -L "$BUNDLE" ]; then
		rm -f "$RECORD" || return 1
		fsync "$MANAGED" || return 1
		return 0
	fi
	expected_owner=$(bundle_owner_value) || return 1
	deletion_source_safe "$BUNDLE" "$expected_owner" || return 1
	if nonce=$(bundle_record_nonce owned); then
		phase=deleting
	else
		nonce=$(new_nonce) || return 1
		case "$nonce" in ''|*[!0-9a-f]*) return 1;; esac
		[ "${#nonce}" -eq 32 ] || return 1
		phase=deleting-legacy
	fi
	value=$(printf 'v2\t%s\t%s\t%s' "$OWNER" "$nonce" "$phase") || return 1
	atomic_value "$RECORD" "$value" || return 1
	resume_bundle_deletion "$nonce" "$phase" "$expected_owner"
}

agent_registration_owned() {
	local snapshot=/var/run/meduza/recovery-procd.$$ status
	mkdir -p /var/run/meduza || return 2
	ubus -S call service list '{"name":"meduza"}' >"$snapshot" 2>/dev/null || return 2
	python3 -c 'import json, sys
try:
    value = json.load(open(sys.argv[1], encoding="utf-8"))
    service = value.get("meduza")
    instances = service.get("instances", {}) if isinstance(service, dict) else {}
    agent = instances.get("agent") if isinstance(instances, dict) else None
    command = agent.get("command") if isinstance(agent, dict) else None
except (OSError, ValueError, AttributeError):
    raise SystemExit(2)
expected = ["/usr/bin/python3", "/usr/libexec/meduza/meduza-agent.py"]
if command == expected:
    raise SystemExit(0)
if not instances:
    raise SystemExit(1)
raise SystemExit(2)' "$snapshot"
	status=$?
	rm -f "$snapshot" || return 2
	return "$status"
}

signal_owned_processes() {
	python3 -c 'import os, signal, sys
roots = ("/usr/libexec/meduza", "/etc/meduza/recovery")
scripts = {}
for root in roots:
    scripts[root + "/meduza-agent.py"] = "python"
    scripts[root + "/meduza-uci-session.py"] = "python"
    scripts[root + "/meduza-generator"] = "shell"
    scripts[root + "/meduza-openwrt-sync"] = "shell"
sig = getattr(signal, "SIG" + sys.argv[1])
for name in os.listdir("/proc"):
    if not name.isdigit() or int(name) == os.getppid():
