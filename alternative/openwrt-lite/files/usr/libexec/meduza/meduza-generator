	cat "$INVENTORY" "$DESIRED" >"$raw" || return 1
	sort -u "$raw" >"$sorted" || return 1
	commit_stage "$sorted" "$MEDUZA_PENDING" 600 || return 1
	rm -f "$raw" || return 1
}

