#!/bin/sh
set -e

# OpenWrt's /lib/functions.sh intentionally uses unset CONFIG_* variables.
IPKG_INSTROOT=${IPKG_INSTROOT:-}
. /lib/functions.sh
MEDUZA_LIBEXEC=${MEDUZA_LIBEXEC:-/usr/libexec/meduza}
. "$MEDUZA_LIBEXEC/meduza-lib.sh"

NODE_JSON=$MEDUZA_STATE/node.json
GLOBAL_JSON=$MEDUZA_STATE/global.json
ALL_JSON=$MEDUZA_STATE/all-nodes.json
DESIRED=$MEDUZA_STATE/desired.interfaces
INVENTORY=$MEDUZA_STATE/inventory.interfaces
LEGACY_AUTH=$MEDUZA_LEGACY_AUTH
TAB=$(printf '\t')
UCI_HELPER=$MEDUZA_LIBEXEC/meduza-uci-session.py
UCI_MIGRATION=$MEDUZA_DATA/managed/uci-migration.interfaces
UCI_MIGRATION_ZONE=$MEDUZA_DATA/managed/uci-migration.zone
UCI_MIGRATION_ZONE_SEAL=$MEDUZA_DATA/managed/uci-migration.zone.seal
UCI_MIGRATION_ZONE_DISABLED=$MEDUZA_DATA/managed/uci-migration.zone.disabled
UPGRADE_STATE=$MEDUZA_DATA/managed/upgrade.state
UPGRADE_INTENT=$MEDUZA_DATA/managed/upgrade.intent
BUILD_ID_FILE=${MEDUZA_BUILD_ID_FILE:-/usr/share/meduza/openwrt-lite-build}
INSTALL_COMPLETE=${MEDUZA_INSTALL_COMPLETE:-$MEDUZA_DATA/managed/install-complete}

jget() { "$MEDUZA_LIBEXEC/meduza-json.py" get "$2" "$1"; }
children() { "$MEDUZA_LIBEXEC/meduza-json.py" children "$2" "$1"; }
enabled() {
	local value
	value=$(jget "$1" "$2") || { log "could not read JSON boolean: $1"; exit 1; }
	value=$(printf '%s' "$value" | tr 'A-Z' 'a-z') || exit 1
	case "$value" in 1|true|yes|on) return 0;; *) return 1;; esac
}
lines() { printf '%s\n' "$1" | tr '\r' '\n' | sed '/^[[:space:]]*$/d'; }
installed() { command -v "$1" >/dev/null 2>&1; }

commit_stage() {
	local stage=$1 target=$2 mode=${3:-600} changed=${4:-}
	atomic_write "$target" "$mode" "$changed" <"$stage" || return 1
	rm -f "$stage" || return 1
}

rename_noreplace() {
	python3 -c '
import ctypes, os, sys
libc = ctypes.CDLL(None, use_errno=True)
try:
    renameat2 = libc.renameat2
except AttributeError:
    raise SystemExit(2)
renameat2.argtypes = (ctypes.c_int, ctypes.c_char_p,
                      ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
renameat2.restype = ctypes.c_int
if renameat2(-100, os.fsencode(sys.argv[1]),
             -100, os.fsencode(sys.argv[2]), 1) != 0:
    error = ctypes.get_errno()
    raise OSError(error, os.strerror(error), sys.argv[2])
' "$1" "$2"
}

atomic_value() {
	local target=$1 mode=$2 changed=$3 value=$4 stage
	stage="$MEDUZA_STATE/stage.value.$$"
	printf '%s\n' "$value" >"$stage" || return 1
	commit_stage "$stage" "$target" "$mode" "$changed"
}

cleanup_orphan_temps() {
	local marker dir path
	for marker in "$MEDUZA_GENERATED"/*/*/.meduza-owner; do
		[ -f "$marker" ] && [ ! -L "$marker" ] || continue
		[ "$(cat "$marker" 2>/dev/null || true)" = "$MEDUZA_OWNER" ] || continue
		dir=${marker%/.meduza-owner}
		find "$dir" -type f -name '*.meduza.*' 2>/dev/null | while IFS= read -r path; do
			rm -f "$path"
		done
	done
	rm -f "$MEDUZA_DATA/managed"/interfaces.meduza.* \
		"$MEDUZA_DATA/managed"/interfaces.pending.meduza.* \
		"$MEDUZA_DATA/managed"/uci-migration.interfaces.meduza.* \
		"$MEDUZA_DATA/managed"/uci-migration.zone.meduza.* \
		"$MEDUZA_DATA/managed"/uci-migration.zone.candidate.* \
		"$MEDUZA_DATA/managed"/uci-migration.zone.raw.* \
		"$MEDUZA_DATA/managed"/uci-migration.zone.seal.new.* \
		"$MEDUZA_DATA/managed"/upgrade.state.meduza.* \
		"$MEDUZA_DATA/managed"/upgrade.first-install.meduza.* \
		"$MEDUZA_DATA/managed"/upgrade.intent.meduza.* \
		"$MEDUZA_DATA/managed"/upgrade.intent.new.* \
		"$MEDUZA_DATA/managed"/install-complete.meduza.* \
		"$MEDUZA_DATA/managed"/uci-ownership.json.tmp.* \
		"$MEDUZA_DATA/managed"/frr.conf.backup.meduza.* \
		"$MEDUZA_DATA/managed"/generated.*.owner.meduza.* 2>/dev/null || true
	rm -f "$MEDUZA_STATE"/stage.* 2>/dev/null || true
}

payload_allows_apply() {
	local build line old_ifs version transaction
	[ -f "$BUILD_ID_FILE" ] && [ ! -L "$BUILD_ID_FILE" ] || {
		log 'package build identity is missing; refusing reconciliation'
		return 1
	}
	[ -f "$INSTALL_COMPLETE" ] && [ ! -L "$INSTALL_COMPLETE" ] || {
		log 'package installation is incomplete; refusing reconciliation'
		return 1
	}
	build=$(cat "$BUILD_ID_FILE") || return 1
	case "$build" in ''|*[!A-Za-z0-9_.-]*) return 1;; esac
	line=$(cat "$INSTALL_COMPLETE") || return 1
	old_ifs=$IFS
	IFS=$TAB
	set -- $line
	IFS=$old_ifs
	[ "$#" -eq 3 ] && [ "$1" = v1 ] && [ "$2" = "$build" ] || return 1
	version=$2
	transaction=$3
	case "$transaction" in ''|*[!0-9a-f]*) return 1;; esac
	[ "${#transaction}" -eq 32 ] || return 1
	PAYLOAD_BUILD=$version
	PAYLOAD_TX=$transaction
}

upgrade_allows_apply() {
	local value old_ifs phase transaction build
	[ ! -e "$UPGRADE_STATE" ] && return 0
	[ -f "$UPGRADE_STATE" ] && [ ! -L "$UPGRADE_STATE" ] || {
		log 'unsafe package-upgrade state; refusing reconciliation'
		return 1
	}
	value=$(cat "$UPGRADE_STATE") || return 1
	old_ifs=$IFS
	IFS=:
	set -- $value
	IFS=$old_ifs
	[ "$#" -eq 3 ] || { log 'invalid package-upgrade state; refusing reconciliation'; return 1; }
	phase=$1
	transaction=$2
	build=$3
	case "$transaction" in ''|*[!0-9a-f]*) phase=invalid;; esac
	[ "${#transaction}" -eq 32 ] || phase=invalid
	[ "$transaction" = "$PAYLOAD_TX" ] && [ "$build" = "$PAYLOAD_BUILD" ] || phase=invalid
	case "$phase" in
		ready) return 0;;
		blocked) log 'package upgrade did not quiesce safely; refusing reconciliation'; return 1;;
		*) log 'invalid package-upgrade state; refusing reconciliation'; return 1;;
	esac
}

reload_or_restart() {
	local service=$1
	[ -x "/etc/init.d/$service" ] || return 0
	"/etc/init.d/$service" reload >/dev/null 2>&1 || "/etc/init.d/$service" restart
}

manifest_line() { printf '%s\t%s\t%s\t%s\t%s' "$1" "$2" "$3" "$4" "$5"; }

manifest_field() {
	local kind=$1 instance=$2 field=$3 file=${4:-$DESIRED}
	awk -F '\t' -v k="$kind" -v i="$instance" -v f="$field" \
		'$1 == k && $2 == i { print $f; exit }' "$file"
}

collect_manifest_file() {
	local file=$1 target=$2 kind instance logical device config extra
	[ -f "$file" ] || return 0
	while IFS="$TAB" read -r kind instance logical device config extra; do
		[ -n "$kind$instance$logical$device$config$extra" ] || continue
		if [ -n "$extra" ] || ! valid_managed_entry "$kind" "$instance" "$logical" "$device" "$config"; then
			log "ignoring unsafe managed-interface record in $file"
			continue
		fi
		manifest_line "$kind" "$instance" "$logical" "$device" "$config" >>"$target"
		printf '\n' >>"$target"
	done <"$file"
}

freeze_uci_migration_inventory() {
	# Snapshot only state that existed at generator entry.  The helper may use
	# this one invocation's snapshot to recover an interrupted previous commit,
	# but never the DESIRED rows that write_journal() is about to add.
	local stage="$MEDUZA_STATE/stage.uci-migration.$$" sorted="$MEDUZA_STATE/stage.uci-migration.sorted.$$"
	: >"$stage" || return 1
	collect_manifest_file "$MEDUZA_MANAGED" "$stage" || return 1
	collect_manifest_file "$MEDUZA_PENDING" "$stage" || return 1
	sort -u "$stage" >"$sorted" || return 1
	commit_stage "$sorted" "$UCI_MIGRATION" 600 || return 1
	rm -f "$stage" || return 1
}

generated_record_path() {
	printf '%s/managed/generated.%s.%s.owner' "$MEDUZA_DATA" "$1" "$2"
}

valid_generated_state() {
	local nonce
	case "$1" in
		owned) return 0;;
		creating-????????????????|deleting-????????????????|empty-????????????????)
			nonce=${1#*-}
			case "$nonce" in *[!0-9a-f]*) return 1;; *) return 0;; esac
			;;
		*) return 1;;
	esac
}

generated_record_state() {
	local kind=$1 instance=$2 logical=$3 device=$4 config=$5 record owner state rk ri rl rd rc extra
	record=$(generated_record_path "$kind" "$instance")
	[ -f "$record" ] && [ ! -L "$record" ] || return 1
	IFS="$TAB" read -r owner state rk ri rl rd rc extra <"$record" || return 1
	[ -z "$extra" ] && [ "$owner" = "$MEDUZA_OWNER" ] && \
		[ "$rk" = "$kind" ] && [ "$ri" = "$instance" ] && \
		[ "$rl" = "$logical" ] && [ "$rd" = "$device" ] && \
		[ "$rc" = "$config" ] || return 1
	valid_generated_state "$state" || return 1
	printf '%s' "$state"
}

write_generated_record() {
	local state=$1 kind=$2 instance=$3 logical=$4 device=$5 config=$6 record value
	valid_managed_entry "$kind" "$instance" "$logical" "$device" "$config" || return 1
	case "$kind:$config" in
		"tinc:$MEDUZA_GENERATED/tinc/$instance/tinc.conf"|\
		"openvpn:$MEDUZA_GENERATED/openvpn/$instance/openvpn.conf"|\
		"wireguard:$MEDUZA_GENERATED/wireguard/$instance/wg.conf") :;;
		*) return 1;;
	esac
	valid_generated_state "$state" || return 1
	record=$(generated_record_path "$kind" "$instance")
	[ ! -L "$record" ] || { log "refusing symlinked generated ownership record: $record"; return 1; }
	value=$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s' \
		"$MEDUZA_OWNER" "$state" "$kind" "$instance" "$logical" "$device" "$config") || return 1
	atomic_value "$record" 600 '' "$value"
}

remove_generated_record() {
	local kind=$1 instance=$2 record
	record=$(generated_record_path "$kind" "$instance")
	[ -e "$record" ] || [ -L "$record" ] || { fsync "$MEDUZA_DATA/managed" || return 1; return 0; }
	[ ! -L "$record" ] || { log "refusing symlinked generated ownership record: $record"; return 1; }
	rm -f "$record" || return 1
	fsync "$MEDUZA_DATA/managed" || return 1
}

collect_generated_records() {
	local target=$1 record owner state kind instance logical device config extra expected
	for record in "$MEDUZA_DATA/managed"/generated.*.owner; do
		[ -f "$record" ] && [ ! -L "$record" ] || continue
		IFS="$TAB" read -r owner state kind instance logical device config extra <"$record" || continue
		expected=$(generated_record_path "$kind" "$instance")
		if [ -n "$extra" ] || [ "$record" != "$expected" ] || \
			[ "$owner" != "$MEDUZA_OWNER" ] || \
			! valid_managed_entry "$kind" "$instance" "$logical" "$device" "$config"; then
			log "ignoring unsafe generated ownership record: $record"
			continue
		fi
		valid_generated_state "$state" || { log "ignoring invalid generated ownership state: $record"; continue; }
		case "$kind:$config" in
			"tinc:$MEDUZA_GENERATED/tinc/$instance/tinc.conf"|\
			"openvpn:$MEDUZA_GENERATED/openvpn/$instance/openvpn.conf"|\
			"wireguard:$MEDUZA_GENERATED/wireguard/$instance/wg.conf") :;;
			*) log "ignoring non-generated ownership path: $record"; continue;;
		esac
		manifest_line "$kind" "$instance" "$logical" "$device" "$config" >>"$target" || return 1
		printf '\n' >>"$target" || return 1
	done
}

entry_is_desired() {
	local line
	line=$(manifest_line "$1" "$2" "$3" "$4" "$5")
	grep -Fqx "$line" "$DESIRED" 2>/dev/null
}

remove_inventory_entry() {
	local kind=$1 instance=$2 logical=$3 device=$4 config=$5 tmp
	tmp="$INVENTORY.remove.$$"
	awk -F '\t' -v k="$kind" -v i="$instance" -v l="$logical" -v d="$device" -v c="$config" \
		'!($1 == k && $2 == i && $3 == l && $4 == d && $5 == c)' "$INVENTORY" >"$tmp"
	mv "$tmp" "$INVENTORY"
}

stop_reused_stale_devices() {
	local kind instance logical device config extra old_kind old_instance old_logical old_device old_config old_extra count line
	local desired_owned stale_file owned_file
	while IFS="$TAB" read -r kind instance logical device config extra; do
		[ -n "$kind$instance$logical$device$config" ] || continue
		ip link show dev "$device" >/dev/null 2>&1 || continue
		line=$(manifest_line "$kind" "$instance" "$logical" "$device" "$config")
		stale_file="$MEDUZA_STATE/reused.entries"
		owned_file="$MEDUZA_STATE/reused.owned"
		awk -F '\t' -v d="$device" -v wanted="$line" '$4 == d && $0 != wanted { print }' \
			"$INVENTORY" >"$stale_file"
		[ -s "$stale_file" ] || continue

		desired_owned=0
		device_is_owned "$kind" "$instance" "$device" && desired_owned=1
		if [ "$desired_owned" = 1 ]; then
			# A previous attempt already switched the kernel object but crashed
			# before publishing MANAGED.  Retire only the stale journal rows; never
			# stop the now-desired device on recovery.
			while IFS="$TAB" read -r old_kind old_instance old_logical old_device old_config old_extra; do
				[ -n "$old_kind" ] || continue
				desired_uses_config "$old_kind" "$old_config" || \
					remove_generated_config "$old_kind" "$old_instance" "$old_device" "$old_config"
				remove_inventory_entry "$old_kind" "$old_instance" "$old_logical" "$old_device" "$old_config"
			done <"$stale_file"
			continue
		fi

		: >"$owned_file"
		while IFS="$TAB" read -r old_kind old_instance old_logical old_device old_config old_extra; do
			case "$old_kind" in openvpn|tinc|wireguard) :;; *) continue;; esac
			device_is_owned "$old_kind" "$old_instance" "$old_device" || continue
			manifest_line "$old_kind" "$old_instance" "$old_logical" "$old_device" "$old_config" >>"$owned_file"
			printf '\n' >>"$owned_file"
		done <"$stale_file"
		count=$(awk -F '\t' '!seen[$1 SUBSEP $2 SUBSEP $4]++ { count++ } END { print count+0 }' "$owned_file")
		[ "$count" -eq 1 ] || { log "device rename has no unique strong owner; refusing to reuse $device"; return 1; }
		# A crash journal may contain both legacy and generated config rows for
		# the same kernel identity.  Stop every representation of that one owner
		# before the device name is reused; counting rows would invent ambiguity.
		while IFS="$TAB" read -r old_kind old_instance old_logical old_device old_config old_extra; do
			[ -n "$old_kind" ] || continue
			stop_runtime_entry "$old_kind" "$old_instance" "$old_logical" "$old_device" "$old_config" || return 1
		done <"$owned_file"
	done <"$DESIRED"
	rm -f "$MEDUZA_STATE/reused.entries" "$MEDUZA_STATE/reused.owned"
}

desired_uses_config() {
	local kind=$1 config=$2
	awk -F '\t' -v k="$kind" -v c="$config" \
		'$1 == k && $5 == c { found=1 } END { exit !found }' "$DESIRED"
}

owned_network_sections() {
	local snapshot="$MEDUZA_STATE/network.show.$$" extracted="$MEDUZA_STATE/network.owned.$$" status logical
	uci -q show network >"$snapshot" 2>/dev/null || { log 'could not read UCI network configuration'; return 1; }
	sed -n "s/^network\.\([^.=]*\)\.meduza_owner='$MEDUZA_OWNER'$/\1/p" \
		"$snapshot" >"$extracted" || return 1
	sort -u "$extracted" -o "$extracted" || return 1
	status=0
	while IFS= read -r logical; do
		[ -n "$logical" ] || continue
		if "$UCI_HELPER" verify-live "network.$logical" >/dev/null 2>&1; then
			printf '%s\n' "$logical"
		else
			[ "$?" -eq 3 ] || status=1
		fi
	done <"$extracted"
	rm -f "$snapshot" "$extracted" || return 1
	return "$status"
}

uci_network_optional_get() {
	local value status
	if value=$(uci -q get "$1" 2>/dev/null); then
		printf '%s' "$value"
		return 0
	else
		status=$?
	fi
	# `uci get` uses the same status for a missing option and package I/O
	# failures.  A successful full package parse is the required proof that
	# this was only an absent value; otherwise inventory collection must abort.
	uci -q show network >/dev/null 2>&1 || {
		log "could not verify missing UCI value: $1"
		return 2
	}
	[ "$status" -ne 0 ] || return 2
	return 0
}

legacy_network_sections() {
	local logical owner snapshot="$MEDUZA_STATE/network.legacy-show.$$" extracted="$MEDUZA_STATE/network.legacy.$$"
	uci -q show network >"$snapshot" 2>/dev/null || { log 'could not read legacy UCI network configuration'; return 1; }
	sed -n "s/^network\.\([^.=]*\)\.meduza='1'$/\1/p" "$snapshot" >"$extracted" || return 1
	while IFS= read -r logical; do
		[ -n "$logical" ] || continue
		owner=$(uci_network_optional_get "network.$logical.meduza_owner") || return 1
		[ -n "$owner" ] || printf '%s\n' "$logical"
	done <"$extracted"
	rm -f "$snapshot" "$extracted" || return 1
}

collect_inventory() {
	local tmp logical kind instance device config owner owned legacy type proto
	tmp=$MEDUZA_STATE/inventory.raw
	: >"$tmp"
	for config in "$MEDUZA_MANAGED" "$MEDUZA_PENDING"; do
		collect_manifest_file "$config" "$tmp"
	done
	# A directory-level transaction record survives even if the aggregate
	# manifest rename was the operation interrupted by power loss.
	collect_generated_records "$tmp" || return 1
	# UCI is a second source of truth if a manifest write was interrupted.
	owned=$(owned_network_sections) || return 1
	legacy=$(legacy_network_sections) || return 1
	for logical in $owned $legacy; do
		kind=$(uci_network_optional_get "network.$logical.meduza_kind") || return 1
		instance=$(uci_network_optional_get "network.$logical.meduza_instance") || return 1
		device=$(uci_network_optional_get "network.$logical.meduza_device") || return 1
		[ -n "$device" ] || device=$(uci_network_optional_get "network.$logical.device") || return 1
		config=$(uci_network_optional_get "network.$logical.meduza_config") || return 1
		if [ -z "$kind" ]; then
			case "$logical" in ovpn_*) kind=openvpn;; wg_*) kind=wireguard;; tinc_*) kind=tinc;; esac
		fi
		[ -n "$instance" ] || instance=${logical#*_}
		if [ -z "$config" ]; then
			case "$kind" in
				openvpn) config="/etc/openvpn/meduza-$instance.conf" ;;
				wireguard) config="$MEDUZA_DATA/wireguard/$instance.conf" ;;
				tinc) config="/etc/tinc/$instance/tinc.conf" ;;
			esac
		fi
		owner=$(uci_network_optional_get "network.$logical.meduza_owner") || return 1
		if [ "$owner" != "$MEDUZA_OWNER" ]; then
			type=$(uci_network_optional_get "network.$logical") || return 1
			proto=$(uci_network_optional_get "network.$logical.proto") || return 1
			[ "$type" = interface ] && [ "$proto" = none ] || continue
			case "$kind" in
				tinc) legacy_tinc_is_owned "$instance" "$device" "$config" || continue ;;
				openvpn) legacy_openvpn_is_owned "$instance" "$device" "$config" || continue ;;
				wireguard) [ -f "$config" ] && grep -q '^\[Interface\]' "$config" || continue ;;
				*) continue;;
			esac
		fi
		if valid_managed_entry "$kind" "$instance" "$logical" "$device" "$config"; then
			manifest_line "$kind" "$instance" "$logical" "$device" "$config" >>"$tmp"
			printf '\n' >>"$tmp"
		else
			log "ignoring unsafe owner-marked UCI interface: $logical"
		fi
	done
	sort -u "$tmp" >"$INVENTORY"
	chmod 600 "$INVENTORY"
}

legacy_tinc_is_owned() {
	local instance=$1 device=$2 config=$3
	[ "$config" = "/etc/tinc/$instance/tinc.conf" ] || return 1
	[ -f "$config" ] || return 1
	grep -qxF 'AddressFamily=ipv4' "$config" &&
		grep -qxF 'Mode=switch' "$config" &&
		grep -qxF 'DeviceType=tap' "$config" &&
		grep -qxF "Interface=$device" "$config" &&
		grep -qxF 'TCPOnly=yes' "$config" &&
		grep -qxF 'ip link set "$INTERFACE" up' "/etc/tinc/$instance/tinc-up" 2>/dev/null
}

adopt_legacy_tinc_inventory() {
	# r23 did not persist an unambiguous tinc ownership marker.  A common
	# switch/tap config fingerprint is not sufficient authority to delete an
	# administrator's /etc/tinc tree.  Legacy entries are migrated only when
	# collect_inventory() found an explicit owner-marked UCI section/manifest.
	return 0
}

append_desired() {
	local kind=$1 instance=$2 logical=$3 device=$4 config=$5 count
	valid_instance_name "$instance" || { log "invalid $kind instance name: $instance"; return 1; }
	valid_uci_name "$logical" || { log "invalid UCI interface name: $logical"; return 1; }
	valid_device_name "$device" || { log "unsafe $kind device name (utun is reserved for OpenClash): $device"; return 1; }
	case "$config" in "$MEDUZA_GENERATED"/*) :;; *) log "unsafe generated path: $config"; return 1;; esac
	count=$(awk -F '\t' -v value="$logical" '$3 == value { count++ } END { print count+0 }' "$DESIRED")
	[ "$count" -eq 0 ] || { log "duplicate UCI interface after name normalization: $logical"; return 1; }
	count=$(awk -F '\t' -v value="$device" '$4 == value { count++ } END { print count+0 }' "$DESIRED")
	[ "$count" -eq 0 ] || { log "duplicate VPN device: $device"; return 1; }
	manifest_line "$kind" "$instance" "$logical" "$device" "$config" >>"$DESIRED"
	printf '\n' >>"$DESIRED"
}

build_desired() {
	local mesh net dev logical raw name requested path
	: >"$DESIRED"
	mesh=$(jget /global/mesh_type "$GLOBAL_JSON")
	if installed tincd && [ "$mesh" = tinc ] && enabled "/nodes/$MEDUZA_NODE/tinc/enable" "$NODE_JSON"; then
		net=$(jget /global/tinc/netname "$GLOBAL_JSON"); [ -n "$net" ] || net=mesh
		valid_instance_name "$net" || { log "invalid tinc netname: $net"; return 1; }
		dev=$(jget "/nodes/$MEDUZA_NODE/tinc/dev_name" "$NODE_JSON"); [ -n "$dev" ] || dev=tnc0
		logical="tinc_$(uci_instance_name "$net")"
		append_desired tinc "$net" "$logical" "$dev" "$MEDUZA_GENERATED/tinc/$net/tinc.conf"
	elif ! installed tincd; then
		log 'tinc is not installed; only previously owned tinc resources will be cleaned'
	fi

	if installed openvpn && { [ -f /lib/netifd/proto/openvpn.sh ] || [ -x /etc/init.d/openvpn ]; }; then
		children "/nodes/$MEDUZA_NODE/openvpn/" "$NODE_JSON" >"$MEDUZA_STATE/openvpn.children" || return 1
		while IFS= read -r raw; do
			[ -n "$raw" ] || continue
			enabled "/nodes/$MEDUZA_NODE/openvpn/$raw/enable" "$NODE_JSON" || continue
			valid_instance_name "$raw" || { log "invalid OpenVPN instance name: $raw"; return 1; }
			name=$raw
			requested=$(jget "/nodes/$MEDUZA_NODE/openvpn/$raw/dev" "$NODE_JSON")
			dev=${requested:-$(default_device_name openvpn "$name")}
			logical="ovpn_$(uci_instance_name "$name")"
			path="$MEDUZA_GENERATED/openvpn/$name/openvpn.conf"
			append_desired openvpn "$name" "$logical" "$dev" "$path"
		done <"$MEDUZA_STATE/openvpn.children"
	else
		log 'OpenVPN integration is not installed; only previously owned OpenVPN resources will be cleaned'
	fi

	if installed wg && installed ip; then
		children "/nodes/$MEDUZA_NODE/wireguard/" "$NODE_JSON" >"$MEDUZA_STATE/wireguard.children" || return 1
		while IFS= read -r raw; do
			[ -n "$raw" ] || continue
			enabled "/nodes/$MEDUZA_NODE/wireguard/$raw/enable" "$NODE_JSON" || continue
			valid_instance_name "$raw" || { log "invalid WireGuard instance name: $raw"; return 1; }
			name=$raw
			requested=$(jget "/nodes/$MEDUZA_NODE/wireguard/$raw/dev" "$NODE_JSON")
			dev=${requested:-$(default_device_name wireguard "$name")}
			logical="wg_$(uci_instance_name "$name")"
			path="$MEDUZA_GENERATED/wireguard/$name/wg.conf"
			append_desired wireguard "$name" "$logical" "$dev" "$path"
		done <"$MEDUZA_STATE/wireguard.children"
	else
		log 'WireGuard tools are not installed; only previously owned WireGuard resources will be cleaned'
	fi
	chmod 600 "$DESIRED"
}

validate_existing_devices() {
	local kind instance logical device config extra
	while IFS="$TAB" read -r kind instance logical device config extra; do
		[ -n "$kind$instance$logical$device$config" ] || continue
		ip link show dev "$device" >/dev/null 2>&1 || continue
		manifest_has_device "$kind" "$instance" "$device" "$INVENTORY" || {
			log "refusing to adopt existing non-Meduza device: $device"; return 1;
		}
		device_is_owned "$kind" "$instance" "$device" || {
			log "refusing to adopt $kind device without its kernel ownership marker: $device"
			return 1
		}
	done <"$DESIRED"
}

preflight_existing_devices() {
	local kind instance logical device config extra old_kind old_instance old_logical old_device old_config old_extra count line old_line pidfile section_type legacy_count legacy_retired identities identity
	while IFS="$TAB" read -r kind instance logical device config extra; do
		[ -n "$kind$instance$logical$device$config" ] || continue
		ip link show dev "$device" >/dev/null 2>&1 || continue
		device_is_owned "$kind" "$instance" "$device" && continue
		# Live r23 upgrades can have the same kind/instance/device but a legacy
		# config path and no ifalias.  Retire the one strictly hashed legacy row
		# while its UCI/procd identity still exists, then rebuild with the private
		# generated path.  A manifest alone never authorizes this migration.
		legacy_count=0
		legacy_retired=0
		while IFS="$TAB" read -r old_kind old_instance old_logical old_device old_config old_extra; do
			[ "$old_device" = "$device" ] || continue
			legacy_config_path "$old_kind" "$old_instance" "$old_config" || continue
			legacy_entry_authorized "$old_kind" "$old_instance" "$old_logical" "$old_device" "$old_config" || continue
			legacy_authorized_hash_matches "$old_kind" "$old_instance" "$old_logical" "$old_device" "$old_config" || continue
			legacy_count=$((legacy_count + 1))
			[ "$legacy_count" -eq 1 ] || continue
			old_line=$(manifest_line "$old_kind" "$old_instance" "$old_logical" "$old_device" "$old_config")
		done <"$INVENTORY"
		if [ "$legacy_count" -gt 1 ]; then
			log "ambiguous legacy ownership for device: $device"
			return 1
		elif [ "$legacy_count" -eq 1 ]; then
			IFS="$TAB" read -r old_kind old_instance old_logical old_device old_config <<-EOF
			$old_line
			EOF
			stop_runtime_entry "$old_kind" "$old_instance" "$old_logical" "$old_device" "$old_config" || return 1
			ip link show dev "$device" >/dev/null 2>&1 || legacy_retired=1
		fi
		[ "$legacy_retired" = 0 ] || continue
		line=$(manifest_line "$kind" "$instance" "$logical" "$device" "$config")
		if grep -Fqx "$line" "$INVENTORY" 2>/dev/null; then
			case "$kind" in
				openvpn)
					if owned_openvpn_process_running "$instance" "$logical" "$device" "$config"; then
						openvpn_runtime_stop_authorized "$instance" "$logical" "$device" "$config" || {
							log "refusing to stop OpenVPN process without current ownership proof: $instance"
							return 1
						}
						if [ "$config" = "$MEDUZA_GENERATED/openvpn/$instance/openvpn.conf" ]; then
							stop_registered_modern_openvpn "$logical" "$config" || return 1
						elif legacy_entry_authorized "$kind" "$instance" "$logical" "$device" "$config" && \
							legacy_authorized_hash_matches "$kind" "$instance" "$logical" "$device" "$config"; then
							[ ! -x /etc/init.d/openvpn ] || /etc/init.d/openvpn stop "meduza-$instance" >/dev/null 2>&1 || return 1
						fi
						stop_owned_openvpn_processes "$instance" "$logical" "$device" "$config"
						if ! wait_openvpn_process_absent "$instance" "$logical" "$device" "$config"; then
							stop_owned_openvpn_processes "$instance" "$logical" "$device" "$config" KILL
							wait_openvpn_process_absent "$instance" "$logical" "$device" "$config" || return 1
						fi
						wait_link_absent "$device" || true
						ip link show dev "$device" >/dev/null 2>&1 || continue
					fi
					;;
				tinc)
					if owned_tinc_process_running "$instance"; then
						pidfile="$MEDUZA_STATE/tinc.$instance.pid"
						stop_owned_tinc_processes "$instance" "$pidfile"
						if ! wait_tinc_process_absent "$instance" 0; then
							stop_owned_tinc_processes "$instance" "$pidfile" KILL
							wait_tinc_process_absent "$instance" 0 || return 1
						fi
						wait_link_absent "$device" || true
						ip link show dev "$device" >/dev/null 2>&1 || continue
					elif legacy_entry_authorized "$kind" "$instance" "$logical" "$device" "$config" && \
						legacy_authorized_hash_matches "$kind" "$instance" "$logical" "$device" "$config" && \
						legacy_tinc_process_running "$instance"; then
						stop_authorized_legacy_tinc_processes "$instance"
						if ! wait_tinc_process_absent "$instance" 1; then
							stop_authorized_legacy_tinc_processes "$instance" KILL
							wait_tinc_process_absent "$instance" 1 || return 1
						fi
						wait_link_absent "$device" || true
						ip link show dev "$device" >/dev/null 2>&1 || continue
					fi
					;;
				wireguard)
					if legacy_wireguard_device_is_owned "$instance" "$logical" "$device" "$config"; then
						mark_device_owned wireguard "$instance" "$device" || return 1
						continue
					fi
					;;
			esac
		fi
		count=0
		identities=''
		while IFS="$TAB" read -r old_kind old_instance old_logical old_device old_config old_extra; do
			[ "$old_device" = "$device" ] || continue
			[ "$old_kind" = "$kind" ] && [ "$old_instance" = "$instance" ] && continue
			device_is_owned "$old_kind" "$old_instance" "$old_device" || continue
			identity="$old_kind/$old_instance/$old_device"
			case " $identities " in *" $identity "*) continue;; esac
			identities="$identities $identity"
			count=$((count + 1))
		done <"$INVENTORY"
		[ "$count" -eq 1 ] || {
			log "refusing UCI changes for existing non-Meduza device: $device"
			return 1
		}
	done <"$DESIRED"
}

legacy_wireguard_device_is_owned() {
	local instance=$1 logical=$2 device=$3 config=$4 expected actual
	[ "$config" = "$MEDUZA_DATA/wireguard/$instance.conf" ] || return 1
	legacy_entry_authorized wireguard "$instance" "$logical" "$device" "$config" || return 1
	legacy_authorized_hash_matches wireguard "$instance" "$logical" "$device" "$config" || return 1
	network_entry_is_owned wireguard "$instance" "$logical" "$device" "$config" || return 1
	command -v wg >/dev/null 2>&1 && wg show "$device" >/dev/null 2>&1 || return 1
	expected=$(sed -n 's/^[[:space:]]*PrivateKey[[:space:]]*=[[:space:]]*//p' "$config" | sed -n '1p')
	[ -n "$expected" ] || return 1
	actual=$(wg show "$device" private-key 2>/dev/null) || return 1
	[ "$actual" = "$expected" ]
}

prepare_legacy_runtime_ownership() {
	local kind instance logical device config extra
	while IFS="$TAB" read -r kind instance logical device config extra; do
		[ "$kind" = wireguard ] || continue
		legacy_config_path "$kind" "$instance" "$config" || continue
		ip link show dev "$device" >/dev/null 2>&1 || continue
		device_is_owned "$kind" "$instance" "$device" && continue
		legacy_wireguard_device_is_owned "$instance" "$logical" "$device" "$config" || {
			log "cannot safely migrate aliasless legacy WireGuard device: $device"
			return 1
		}
		mark_device_owned "$kind" "$instance" "$device" || return 1
	done <"$INVENTORY"
}

write_journal() {
