		"$MEDUZA_OWNER" "$1" "$2" "$3" "$4" "$5" "$6"
}

generated_delete_marker_is_owned() {
	local dir=$1 nonce=$2 kind=$3 instance=$4 logical=$5 device=$6 config=$7 marker expected actual
	marker="$dir/.meduza-delete"
	[ -d "$dir" ] && [ ! -L "$dir" ] || return 1
