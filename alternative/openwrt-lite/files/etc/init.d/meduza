#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	config_load meduza
	local enable
	config_get_bool enable main enable 0
	[ "$enable" = 1 ] || return 0

	# Routed side-gateway only: never change WAN, DHCP, DNS, NAT or firewall.
	# Forwarding is required for traffic explicitly routed through this node.
	sysctl -qw net.ipv4.ip_forward=1

	procd_open_instance generator
	procd_set_param command /usr/libexec/meduza/meduza-generator --daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance reporter
	procd_set_param command /usr/libexec/meduza/meduza-reporter
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger meduza
}

reload_service() {
	stop
	start
}
