#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/meduza-openwrt
MEDUZA_START_STATUS=0

extra_command "purge" "Stop Meduza and remove all owner-marked resources"
extra_command "recover" "Replay or roll back an interrupted transaction"
extra_command "doctor" "Check configuration and native runtime dependencies"
extra_command "status_json" "Print detailed Meduza status as JSON"
extra_command "reconcile_settings" "Apply the current enabled or disabled controller state"

start_service() {
	local enable
	MEDUZA_START_STATUS=0
	config_load meduza
	config_get_bool enable main enable 0
	[ -x "$PROG" ] || {
		logger -t meduza "cannot start: $PROG is missing or not executable"
		MEDUZA_START_STATUS=1
		return 0
	}
	if [ "$enable" != 1 ]; then
		# Clean up without loading or validating etcd credentials, then publish
		# a volatile "disabled" status for LuCI. No etcd connection is made.
		"$PROG" purge --disabled || MEDUZA_START_STATUS=$?
		return 0
	fi

	procd_open_instance main
	procd_set_param command "$PROG" daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 30
	procd_set_param limits core="0"
	procd_close_instance
}

service_started() {
	[ "${MEDUZA_START_STATUS:-0}" -eq 0 ] || return "$MEDUZA_START_STATUS"
}

service_triggers() {
	procd_add_reload_trigger meduza
}

reload_service() {
	# A restart also causes startup recovery to run before a new etcd snapshot is
	# accepted.  It therefore remains safe if power was lost during the reload.
	restart
}

meduza_service_registered() {
	local services
	services=$(ubus -S call service list '{"name":"meduza"}' 2>/dev/null) || return 2
	case "$services" in
		*'"meduza"'*) return 0 ;;
		*) return 1 ;;
	esac
}

meduza_instance_running() {
	local services
	services=$(ubus -S call service list '{"name":"meduza"}' 2>/dev/null) || return 2
	case "$services" in
		*'"running":true'*|*'"running": true'*) return 0 ;;
		*) return 1 ;;
	esac
}

restart() {
	local status
	# A disabled controller has no procd instance. Treat that state as a clean
	# restart source instead of failing on `ubus service delete ... Not found`.
	if meduza_service_registered; then
		stop || return 1
	else
		status=$?
		[ "$status" -eq 1 ] || return "$status"
	fi
	start
}

reconcile_settings() {
	local enable status
	config_load meduza
	config_get_bool enable main enable 0

	if [ "$enable" = 1 ]; then
		# A running instance receives the ordinary UCI reload trigger. Do not
		# bounce it a second time when LuCI observes the same committed change.
		if meduza_instance_running; then
			return 0
		else
			status=$?
			[ "$status" -eq 1 ] || return "$status"
		fi
		start
		return $?
	fi

	# Disabled mode has no persistent procd instance. A restart performs the
	# owner-aware cleanup and publishes the explicit disabled status.
	restart
}

service_stopped() {
	# procd calls this after the supervised process is gone, so cleanup cannot
	# race an in-flight reconcile.  Persistent LKG and ownership remain intact.
	"$PROG" runtime-stop
}

purge() {
	stop || return 1
	"$PROG" purge
}

recover() {
	stop || return 1
	"$PROG" recover
}

doctor() {
	"$PROG" doctor
}

status_json() {
	"$PROG" status --json
}

meduza_rc_link_owned() {
	local path=$1 target
	[ -L "$path" ] || return 1
	target=$(readlink "$path") || return 1
	[ "$target" = "../init.d/meduza" ] || [ "$target" = "/etc/init.d/meduza" ]
}

meduza_validate_rc_link() {
	local path=$1
	[ ! -e "$path" ] && [ ! -L "$path" ] && return 0
	meduza_rc_link_owned "$path" || {
		logger -t meduza "refusing to replace foreign rc.d entry: $path"
		return 1
	}
}

enable() {
	local s=/etc/rc.d/S95meduza k=/etc/rc.d/K10meduza
	meduza_validate_rc_link "$s" || return 1
	meduza_validate_rc_link "$k" || return 1
	[ -L "$s" ] || ln -s ../init.d/meduza "$s" || return 1
	[ -L "$k" ] || ln -s ../init.d/meduza "$k" || return 1
}

disable() {
	local s=/etc/rc.d/S95meduza k=/etc/rc.d/K10meduza
	meduza_validate_rc_link "$s" || return 1
	meduza_validate_rc_link "$k" || return 1
	[ ! -L "$s" ] || rm -f "$s" || return 1
	[ ! -L "$k" ] || rm -f "$k" || return 1
}

enabled() {
	meduza_rc_link_owned /etc/rc.d/S95meduza
}
